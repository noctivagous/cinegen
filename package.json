{
  "name": "cinegen",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:key-files": "node scripts/ensure-backend-key-files.mjs",
    "lint:legacy-globals": "node scripts/check-window-cinegen-writes.mjs && node scripts/check-raw-custom-event-strings.mjs && node scripts/check-no-localstorage.mjs",
    "predev": "npm run setup:key-files",
    "dev": "vite",
    "prebuild": "npm run setup:key-files",
    "build": "npm run lint:legacy-globals && tsc --noEmit && vite build",
    "validate:cine": "npx tsx scripts/validate-cine-package-fs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/index.mjs",
    "postinstall": "npm run setup:key-files"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "lit": "^3.3.3",
    "ws": "8.20.1",
    "yauzl": "^3.3.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.21",
    "autoprefixer": "^10.5.0",
    "happy-dom": "^20.10.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
}
